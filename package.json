    "check": "node scripts/check.mjs",
    "test:plugin": "node scripts/test-plugin.mjs",
    "test:companion": "node scripts/test-companion.mjs",
    "test:autoplay": "node scripts/test-autoplay.mjs",
    "test:home-options": "node scripts/test-home-options.mjs",
    "test:responsive": "node scripts/test-responsive.mjs",
    "test:formats": "node scripts/test-formats.mjs",
    "test:plugin-settings": "node scripts/test-plugin-settings.mjs",
    "test:branding": "node scripts/test-branding.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:dashboard": "node scripts/test-dashboard.mjs",
    "test:dashboard-layout": "node scripts/test-dashboard-layout.mjs",
    "test:polish": "node scripts/test-polish.mjs",
    "browser": "node scripts/browser.mjs",
    "preview": "node scripts/browser-command.mjs preview",
    "verify:instance": "node scripts/validate-instance.mjs",
    "verify:companion": "node scripts/validate-companion.mjs",
