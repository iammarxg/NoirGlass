<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NoirGlass.Plugin</AssemblyName>
    <Version>1.2.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" ExcludeAssets="runtime" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../dist/noirglass.companion.js" LogicalName="NoirGlass.Plugin.Browser.companion.js" />
    <EmbeddedResource Include="Configuration/configPage.html" LogicalName="NoirGlass.Plugin.Configuration.configPage.html" />
  </ItemGroup>
</Project>
